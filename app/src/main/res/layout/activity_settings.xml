<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/settings_star"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/polaris_star"
        android:layout_gravity="end"
        android:padding="4dp"
        android:contentDescription="@string/settings_button_description" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_language_label"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="48dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/lang_english_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center"
            android:background="#1A1F4E"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="@string/lang_english" />

        <TextView
            android:id="@+id/lang_english_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="20dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="@string/active_language_marker"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lang_russian_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center"
            android:background="#1A1F4E"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="@string/lang_russian" />

        <TextView
            android:id="@+id/lang_russian_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="20dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="@string/active_language_marker"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lang_chinese_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center"
            android:background="#1A1F4E"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="@string/lang_chinese" />

        <TextView
            android:id="@+id/lang_chinese_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="20dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="@string/active_language_marker"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_feedback_label"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/feedback_telegram_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center"
        android:background="#1A1F4E"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        android:text="@string/feedback_telegram" />

    <TextView
        android:id="@+id/feedback_email_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center"
        android:background="#1A1F4E"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:text="@string/feedback_email" />

    <TextView
        android:id="@+id/settings_guide_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1F4E"
        android:gravity="center"
        android:minHeight="56dp"
        android:text="@string/settings_guide_label"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_bubble_label"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="#1A1F4E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_bubble_toggle_label"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/bubble_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>